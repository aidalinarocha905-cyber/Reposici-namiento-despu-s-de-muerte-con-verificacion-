-- SECOND CHANCE UNIVERSAL v2 | DELTA MOBILE -- Recuerda el lugar de muerte y corrige la posición tras aparecer.  local Players = game:GetService("Players") local RunService = game:GetService("RunService")  local player = Players.LocalPlayer  local deathCFrame = nil local lastDeathCharacter = nil local positioning = false  local function rememberDeath(character)     if character == lastDeathCharacter then return end     lastDeathCharacter = character      local humanoid = character:WaitForChild("Humanoid", 10)     local root = character:WaitForChild("HumanoidRootPart", 10)      if not humanoid or not root then return end      humanoid.Died:Connect(function()         deathCFrame = root.CFrame     end) end  local function restorePosition(character)     if positioning or not deathCFrame then return end     positioning = true      task.spawn(function()         local humanoid = character:WaitForChild("Humanoid", 10)         local root = character:WaitForChild("HumanoidRootPart", 10)          if not humanoid or not root then             positioning = false             return         end          -- Esperar a que el personaje se estabilice.         task.wait(1)          -- Reintentar durante unos segundos por si el juego         -- lo devuelve al spawn normal.         for i = 1, 12 do             if player.Character ~= character                 or humanoid.Health <= 0 then                 break             end              character:PivotTo(                 deathCFrame + Vector3.new(0, 3, 0)             )              root.AssemblyLinearVelocity = Vector3.zero             root.AssemblyAngularVelocity = Vector3.zero              task.wait(0.5)         end          -- Intento de curación local.         if player.Character == character and humanoid.Health > 0 then             humanoid.Health = humanoid.MaxHealth         end          positioning = false     end) end  local function onCharacterAdded(character)     rememberDeath(character)     restorePosition(character) end  if player.Character then     onCharacterAdded(player.Character) end  player.CharacterAdded:Connect(onCharacterAdded)
